---
// 5B, part 3: LU, Cholesky, QR and inv(H) * b on the Hilbert matrix of order
// 4 to 15: backward errors (the factorizations stay near eps, the inverse
// does not) and forward errors against cond(H) * eps.
// Data: examples/phase05_dense_decompositions/solve_three_ways.cpp --trace.
import AnimationShell from './AnimationShell.astro';
import trace from '../../data/traces/solve_three_ways.json';
import traceUrl from '../../data/traces/solve_three_ways.json?url';
import { fmt } from './lib/plot.js';

type Row = { n: number; cond: number; cholesky_info: number; methods: { method: string; backward: number | null; forward: number | null }[] };
const rows = trace.hilbert as Row[];
const eps = 2.220446049250313e-16;
const of = (r: Row, name: string) => r.methods.find((m) => m.method === name)!;
const factorizations = ['LU', 'Cholesky', 'QR'];
const worstFactor = Math.max(...rows.flatMap((r) => factorizations.map((m) => of(r, m).backward ?? 0)));
const inv = rows.map((r) => of(r, 'inv(H) * b').backward as number);
const invMax = Math.max(...inv);
const invMaxN = rows[inv.indexOf(invMax)].n;
const firstFail = trace.hilbert_cholesky_first_fail as number;
const lastOk = rows.find((r) => r.n === firstFail - 1)!;
const resolved = rows.filter((r) => r.cond < 1e16);
const luWithin = resolved.filter((r) => (of(r, 'LU').forward as number) <= r.cond * eps).length;
// A backward error of exactly 0 (x̂ = x to the last bit) has no place on a log axis.
const exact = rows[0].methods
  .map((m) => ({ method: m.method, ns: rows.filter((r) => of(r, m.method).backward === 0).map((r) => r.n) }))
  .filter((e) => e.ns.length > 0)
  .map((e) => `${e.method} at n = ${e.ns.length > 1 ? `${e.ns.slice(0, -1).join(', ')} and ${e.ns[e.ns.length - 1]}` : e.ns[0]}`);
---

<AnimationShell
  kind="hilbert"
  trace={traceUrl}
  title="The Hilbert matrix: why not inv(A) * b"
  label="Two log plots against the Hilbert order n from 4 to 15: the backward errors of LU, Cholesky, QR and the explicit inverse, and their forward errors against cond(H) times machine epsilon."
  height={262}
>
  <div class="exfig-legend" slot="legend">
    <span><i style="background: var(--ex-c1)"></i>LU</span>
    <span><i style="background: var(--ex-c3)"></i>Cholesky</span>
    <span><i style="background: var(--ex-c2)"></i>QR</span>
    <span><i style="background: var(--ex-c5)"></i>inv(H) * b</span>
    <span><i style="background: var(--ex-muted)"></i>cond(H) · ε</span>
  </div>
  <p>
    Part 3 of the program solves H x = b for x = (1, …, 1), with H(i, j) = 1 / (i + j + 1), for n = {rows[0].n} to
    {rows[rows.length - 1].n}. Left: the backward error ‖b − Hx̂‖ / (‖H‖ ‖x̂‖), how well each method solved the
    system it was given. Right: the forward error ‖x̂ − x‖ / ‖x‖, how close it came to x. Both in the ∞-norm.
  </p>
  <p>
    The three factorizations are backward stable: their backward error never exceeds {fmt(worstFactor, 2)}, about
    {Math.ceil(worstFactor / eps)}ε. The inverse's rises from {fmt(inv[0], 2)} at n = {rows[0].n} to {fmt(invMax, 2)} at
    n = {invMaxN}. Every forward error grows with cond(H), because the problem itself is that sensitive; LU's stays
    below cond(H)·ε at {luWithin} of the {resolved.length} orders where the SVD can still resolve cond(H), below 1e16.
    Cholesky fails from n = {firstFail} on, though H is SPD: past cond(H) = 1/ε, H is positive definite only up to
    rounding. At n = {lastOk.n}, with cond(H) = {fmt(lastOk.cond, 2)}, it still succeeds.
    {exact.length > 0 && <>The backward error is exactly 0, which a log axis cannot show, for {exact.join(', ')}.</>}
  </p>
</AnimationShell>

<script>
  import { createPlayer, mountAll } from './lib/player.js';
  import { hilbertModel } from './lib/models.js';
  import { scaleLinear, scaleLog, logDomain, logTicks, linePath, drawAxes, svg, clear, fmt, fmtPow10 } from './lib/plot.js';

  mountAll('[data-ex="hilbert"]', (root, trace) => {
    const model = hilbertModel(trace);
    const el = root.querySelector('[data-ex-svg]');
    clear(el);
    const axes = svg('g');
    el.append(axes);
    const ns = model.n;
    const colors = { LU: 'var(--ex-c1)', Cholesky: 'var(--ex-c3)', QR: 'var(--ex-c2)', 'inv(H) * b': 'var(--ex-c5)' };
    const xTicks = ns.filter((n) => n % 2 === 0);

    const panel = (box, key, yLabel, extra) => {
      const sx = scaleLinear([ns[0], ns[ns.length - 1]], [box.left, box.right]);
      const dom = logDomain([...model.series.flatMap((s) => s[key]), ...extra].filter((v) => v !== null && v > 0));
      const sy = scaleLog(dom, [box.bottom, box.top]);
      drawAxes(axes, box, sx, sy, { xTicks, yTicks: logTicks(dom, 6), yFmt: fmtPow10, xLabel: 'n', yLabel });
      const paths = model.series.map((s) => ({
        s,
        path: el.appendChild(svg('path', { class: 'ex-series', stroke: colors[s.method], 'stroke-width': 1.75 })),
        dot: el.appendChild(svg('circle', { r: 3, fill: colors[s.method] })),
      }));
      return { sx, sy, paths, key };
    };
    const left = panel({ left: 66, right: 304, top: 38, bottom: 222 }, 'backward', 'backward error', [model.eps]);
    const right = panel({ left: 392, right: 630, top: 38, bottom: 222 }, 'forward', 'forward error', model.condEps);

    // References: eps on the left, cond(H) * eps on the right.
    const e = left.sy(model.eps);
    el.append(svg('line', { x1: 66, x2: 304, y1: e, y2: e, class: 'ex-cursor' }));
    el.append(svg('text', { x: 300, y: e - 4, 'text-anchor': 'end', class: 'ex-tick' }, 'ε'));
    const ref = el.appendChild(svg('path', { class: 'ex-series', stroke: 'var(--ex-muted)', 'stroke-dasharray': '4 3', 'stroke-width': 1.5 }));
    const fail = el.appendChild(svg('text', { x: 16, y: 12, class: 'ex-label' }));

    const draw = (p, k) => {
      for (const { s, path, dot } of p.paths) {
        // Up to the last order this method solved, within the first k + 1.
        const xs = [];
        const ys = [];
        // A zero error is left out: a log axis has no place for it.
        for (let i = 0; i <= k; ++i) if (s[p.key][i] !== null && s[p.key][i] > 0) { xs.push(ns[i]); ys.push(s[p.key][i]); }
        path.setAttribute('d', xs.length ? linePath(xs, ys, p.sx, p.sy) : '');
        const v = s[p.key][k];
        dot.style.display = v === null || v <= 0 ? 'none' : '';
        if (v !== null && v > 0) {
          dot.setAttribute('cx', p.sx(ns[k]));
          dot.setAttribute('cy', p.sy(v));
        }
      }
    };

    createPlayer(root, {
      count: model.count,
      frameMs: 900,
      tweenMs: 0,
      render(k) {
        draw(left, k);
        draw(right, k);
        ref.setAttribute('d', linePath(ns.slice(0, k + 1), model.condEps.slice(0, k + 1), right.sx, right.sy));
        fail.textContent = model.choleskyInfo[k] !== 0 ? `n = ${ns[k]}: Cholesky fails at step ${model.choleskyInfo[k]}` : `n = ${ns[k]}`;
      },
      label(k) {
        const parts = model.series.map((s) => (s.backward[k] === null ? `${s.method} failed` : `${s.method} ${fmt(s.backward[k], 2)}`));
        return `Hilbert order ${ns[k]}, cond(H) ${fmt(model.cond[k], 2)}: backward errors ${parts.join(', ')}.`;
      },
    });
  });
</script>
